// Public site (insurefirst.ae) on Cloudflare Workers static assets.
// Deploy: npm run build && npx wrangler deploy
// The portal is a separate worker — see wrangler.portal.jsonc.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "414b1659c406e5f61356cb09b85b442f",
  "name": "insurefirst-site",
  "compatibility_date": "2026-08-01",
  "routes": [
    { "pattern": "insurefirst.ae", "custom_domain": true, "zone_id": "bf15a1dd6164327ebabb2bb9b0a70986" },
    { "pattern": "www.insurefirst.ae", "custom_domain": true, "zone_id": "bf15a1dd6164327ebabb2bb9b0a70986" }
  ],
  "assets": {
    "directory": "./dist",
    // Every route is prerendered, so an unmatched URL is genuinely missing and
    // should say so with a 404 status rather than a 200 SPA shell. Serving the
    // shell here would now mean serving the prerendered HOMEPAGE — content,
    // canonical and all — for every dead URL.
    "not_found_handling": "404-page",
    // The prerender build writes dist/<route>/index.html. The default
    // (auto-trailing-slash) would 307 /insurance/x to /insurance/x/, which
    // contradicts the canonical tags and the sitemap — both of which use the
    // bare path. Drop the slash instead, so the canonical URL is the one that
    // actually serves a 200.
    "html_handling": "drop-trailing-slash"
  }
}
