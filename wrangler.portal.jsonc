// Staff portal (portal.insurefirst.ae) on Cloudflare Workers static assets.
// Deploy: npm run build:portal && npx wrangler deploy -c wrangler.portal.jsonc
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "414b1659c406e5f61356cb09b85b442f",
  "name": "insurefirst-portal",
  "compatibility_date": "2026-08-01",
  "routes": [
    { "pattern": "portal.insurefirst.ae", "custom_domain": true, "zone_id": "bf15a1dd6164327ebabb2bb9b0a70986" }
  ],
  "assets": {
    "directory": "./dist-portal",
    "not_found_handling": "single-page-application"
  }
}
