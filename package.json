{
  "name": "ensurio-first-landingpage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:server && npm run prerender",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.jsx --outDir .prerender",
    "prerender": "node scripts/prerender.mjs",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview",
    "dev:portal": "vite --config vite.portal.config.js",
    "build:portal": "vite build --config vite.portal.config.js",
    "preview:portal": "vite preview --config vite.portal.config.js",
    "deploy:portal": "npm run build:portal && wrangler deploy -c wrangler.portal.jsonc",
    "serve": "wrangler dev"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^1.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.51.0",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.5.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.15",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "vite": "^5.3.0",
    "wrangler": "^4.135.0"
  },
  "engines": {
    "node": ">=22"
  }
}
