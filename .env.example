# Supabase — lead capture (quote/contact form submissions)
# Copy this file to `.env.local` and fill in your project's values.
# Both are safe to expose in the frontend; Row Level Security protects the data.
# Find them in Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ─────────────────────────────────────────────────────────────────────────────
# The frontend needs nothing else. Everything below is set as Edge Function
# secrets in Supabase (Project Settings → Edge Functions → Secrets), NOT here —
# they are server-side and must never reach the browser bundle.
#
#   RESEND_API_KEY      required, or no email is sent (leads still save)
#   LEAD_FROM_EMAIL     default: Insure First <noreply@insurefirst.ae>
#   LEAD_NOTIFY_EMAIL   default: consult@insurefirst.ae
#   SITE_URL            default: https://www.insurefirst.ae
#   LEAD_PHONE_DISPLAY  default: 050 976 5976
#   LEAD_PHONE_E164     default: +971509765976
#
# See TODO.md → "Lead email pipeline" for the setup steps.
# ─────────────────────────────────────────────────────────────────────────────
