# ⚠ THIS FILE IS COMMITTED TO GIT. Placeholders only — never paste a real key,
# token or secret here, not even temporarily and not even commented out.
# `.env.local` is gitignored; this file is not.

# Supabase — lead capture (quote/contact form submissions)
# Copy this file to `.env.local` and fill in your project's values.
# Both are safe to expose in the frontend; Row Level Security protects the data.
# Find them in Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Cloudflare Turnstile — bot protection on every lead form. The SITE key is
# public and safe to ship (set it on both Vercel projects too). The SECRET key
# is NOT a VITE_ var: it goes only in Supabase Edge Function secrets, as
# TURNSTILE_SECRET_KEY. Without a site key here, forms submit without a token
# and submit-lead quarantines those leads once its secret is configured.
VITE_TURNSTILE_SITEKEY=your-turnstile-site-key

# ─────────────────────────────────────────────────────────────────────────────
# The frontend needs nothing else. Everything below is set as Edge Function
# secrets in Supabase (Project Settings → Edge Functions → Secrets), NOT here —
# they are server-side and must never reach the browser bundle.
#
#   RESEND_API_KEY       required, or no email is sent (leads still save)
#   LEAD_FROM_EMAIL      default: Insure First <noreply@insurefirst.ae>
#   LEAD_NOTIFY_EMAIL    default: consult@insurefirst.ae
#   SITE_URL             default: https://www.insurefirst.ae
#   LEAD_PHONE_DISPLAY   default: 050 976 5976
#   LEAD_PHONE_E164      default: +971509765976
#   TURNSTILE_SECRET_KEY spam gate — when unset, Turnstile checks are skipped
#   ALLOWED_ORIGINS      default: https://www.insurefirst.ae,https://insurefirst.ae
#
# See TODO.md → "Lead email pipeline" for the setup steps.
# ─────────────────────────────────────────────────────────────────────────────
